# Loxone Intercom2 Bridge — Environment Variables
# Copy to .env and fill in real values

# Miniserver IP (required — bridge auto-discovers WSS URL from this)
LOXONE_MINISERVER_IP=192.168.1.100

# Miniserver login credentials (required — user needs rights on the Intercom)
LOXONE_MINISERVER_USER=your_miniserver_user
LOXONE_MINISERVER_PASS=your_miniserver_password

# Optional: specific Intercom device UUID (for multi-intercom setups)
# Leave empty to auto-select the first IntercomV2 found
# LOXONE_DEVICE_UUID=

# Optional: full WSS proxy URL override (skips auto-discovery entirely)
# LOXONE_PROXY_URL=wss://miniserver-ddns-hostname.dyndns.loxonecloud.com/proxy/device-uuid/

# TURN/STUN server addresses (infrastructural constants, same for all installations)
LOXONE_TURN_SERVER=stun.loxonecloud.com:3478
LOXONE_STUN_SERVER=stun.l.google.com:19302

# TURN credentials are fetched AUTOMATICALLY from the Miniserver via
# the JSON-RPC `info` method on each connect. No manual config needed.

# Logging
LOXONE_LOG_LEVEL=INFO
