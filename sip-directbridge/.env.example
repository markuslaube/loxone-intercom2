# Loxone Miniserver
LOXONE_MINISERVER_IP=192.168.1.196
LOXONE_MINISERVER_PORT=80
LOXONE_MINISERVER_USER=myuser
LOXONE_MINISERVER_PASS=mypassword
# Leave empty to auto-discover from LoxAPP3.json
LOXONE_DOORBELL_UUID=

# Intercom
LOXONE_INTERCOM_IP=192.168.1.190
LOXONE_INTERCOM_SIP_URI=sip:smarthome@192.168.1.190

# SIP Registrar (FritzBox)
SIP_REGISTRAR=192.168.1.253
SIP_REGISTRAR_IP=192.168.1.253
SIP_USER=sipuser
SIP_PASSWORD=
SIP_DESTINATION=**610

# Local
LOCAL_IP=192.168.1.23
LOCAL_RTP_PORT_INTERCOM=5004
LOCAL_RTP_PORT_FRITZBOX=5006
SIP_LISTEN_PORT=5060

# Webhook (when using --webhook)
WEBHOOK_PORT=42713

# Misc
KEEPALIVE_SECONDS=240
CALL_TIMEOUT=0

# Accept incoming calls (dial the bridge extension to speak to Intercom)
# Enabled by default. Registers as SIP extension at the registrar.
ACCEPT_CALL=true
