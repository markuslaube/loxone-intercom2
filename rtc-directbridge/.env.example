# Loxone Intercom2 Direct Bridge — Environment Variables
# Copy to .env and fill in real values

# Intercom IP address (required — direct WS connection)
LOXONE_INTERCOM_IP=192.168.1.190

# TURN/STUN server addresses (defaults work for Loxone Intercom Gen.2)
LOXONE_TURN_SERVER=stun.loxonecloud.com:3478
LOXONE_STUN_SERVER=stun.l.google.com:19302

# Stream name for go2rtc registration
LOXONE_STREAM_NAME=loxone_intercom

# go2rtc API URL (for auto-registration)
GO2RTC_API_URL=http://go2rtc:1984

# Logging
LOXONE_LOG_LEVEL=INFO
